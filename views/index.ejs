<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Fast Food</title>

  <!-- BOOTSTRAP -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<!--  NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand" href="/"> FastFood</a>
  </div>
</nav>
<!-- Rasm  -->
<div id="carouselExample" class="carousel slide mb-5">
  <div class="carousel-inner">

    <div class="carousel-item active">
      <img src="https://images.unsplash.com/photo-1600891964092-4316c288032e" class="d-block w-100" style="height:400px; object-fit:cover;">
    </div>

    <div class="carousel-item">
      <img src="https://images.unsplash.com/photo-1550547660-d9450f859349" class="d-block w-100" style="height:400px; object-fit:cover;">
    </div>

    <div class="carousel-item">
      <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd" class="d-block w-100" style="height:400px; object-fit:cover;">
    </div>

  </div>
</div>
<!-- Rasm  --> 

<!-- Taom qoshish  -->
    <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addModal">
      + Taom Qo'shish
    </button>
    <!-- Taom qoshish -->

<!--  PRODUCTS -->
<div class="container mt-5">
  <div class="row">

    <% products.forEach(p => { %>
      <div class="col-md-4 mb-4">
        <div class="card shadow">
          <div class="card-body">
            <img src="https://picsum.photos/200/200" class="card-img-top" alt="...">
            <h5><%= p.name %></h5>
            <p><%= p.desc %></p>
            <h6 class="text-success"><%= p.price %> so'm</h6>

            <a href="/product/<%=p.id %>" class="btn btn-primary btn-sm">View</a>
            <a href="/delete/<%= p.id %>" class="btn btn-danger btn-sm">Delete</a>
          </div>
        </div>
      </div>
    <% }) %>

  </div>
</div> 



<!--  MODAL (ADD PRODUCT) -->
<div class="modal fade" id="addModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title">Add Product</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">

        <form action="/add" method="POST">

          <div class="mb-3">
            <label>Name</label>
            <input type="text" name="name" class="form-control" required>
          </div>

          <div class="mb-3">
            <label>Price</label>
            <input type="number" name="price" class="form-control" required>
          </div>

          <div class="mb-3">
            <label>Description</label>
            <input type="text" name="desc" class="form-control">
          </div>

          <button class="btn btn-success w-100">Save</button>

        </form>

      </div>

    </div>
  </div>
</div>

<!-- BOOTSTRAP JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>